# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ─── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/attendance_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-hex-string-before-any-deploy-!!
JWT_REFRESH_SECRET=change-me-to-a-different-64-char-random-hex-string-please-!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── QR Settings ───────────────────────────────────────────────────────────────
QR_TOKEN_TTL_SECS=45
QR_LOCATION_RADIUS=100

# ─── AI Microservice ───────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Email (optional for local dev) ────────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key
FROM_EMAIL=noreply@attendance.local

# ─── Twilio SMS (optional) ──────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# ─── AWS S3 (optional for local dev) ───────────────────────────────────────────
AWS_REGION=us-east-1
AWS_BUCKET_NAME=attendance-local-dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Policy ────────────────────────────────────────────────────────────────────
MIN_ATTENDANCE_PCT=75
BCRYPT_ROUNDS=10
