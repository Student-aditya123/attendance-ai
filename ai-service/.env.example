# ── AI Service Environment Variables ──────────────────────────────────────────
APP_ENV=development
PORT=8000
LOG_LEVEL=info

# ── MongoDB (used by training scripts to pull real data) ──────────────────────
MONGO_URI=mongodb://localhost:27017/attendance_db

# ── AWS S3 (face encoding storage) ───────────────────────────────────────────
# In production: use IAM role instead of keys (leave blank, role auto-attached)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=attendance-face-data

# ── Face recognition tuning ────────────────────────────────────────────────────
# Lower = stricter (fewer false accepts, more false rejects)
# 0.50 is recommended for attendance (high security)
# 0.60 is dlib's default (higher acceptance rate)
FACE_DISTANCE_THRESHOLD=0.50
FACE_MIN_CONFIDENCE=0.80
FACE_MAX_SAMPLES=5

# ── Risk model ────────────────────────────────────────────────────────────────
RISK_MODEL_PATH=/app/models/risk_model.joblib
RISK_MODEL_VERSION=2.1

# ── Attendance policy ─────────────────────────────────────────────────────────
MIN_ATTENDANCE_PCT=75.0
