{
  "version": "0.2.0",
  "configurations": [

    // ── Backend: Node.js ─────────────────────────────────────────────────────
    {
      "name":        "🟢 Debug Backend (Node.js)",
      "type":        "node",
      "request":     "launch",
      "program":     "${workspaceFolder}/backend/server.js",
      "cwd":         "${workspaceFolder}/backend",
      "envFile":     "${workspaceFolder}/backend/.env",
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps":  true,
      "console":     "integratedTerminal",
      "restart":     true,
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect"],
      "skipFiles":   ["<node_internals>/**", "node_modules/**"]
    },

    // ── Backend: attach to running process ───────────────────────────────────
    {
      "name":      "🔗 Attach to Backend",
      "type":      "node",
      "request":   "attach",
      "port":      9229,
      "skipFiles": ["<node_internals>/**"]
    },

    // ── AI Service: Python (FastAPI) ─────────────────────────────────────────
    {
      "name":           "🐍 Debug AI Service (FastAPI)",
      "type":           "debugpy",
      "request":        "launch",
      "module":         "uvicorn",
      "args":           ["main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd":            "${workspaceFolder}/ai-service",
      "envFile":        "${workspaceFolder}/ai-service/.env",
      "justMyCode":     false,
      "console":        "integratedTerminal"
    },

    // ── Backend: run tests ───────────────────────────────────────────────────
    {
      "name":        "🧪 Debug Backend Tests",
      "type":        "node",
      "request":     "launch",
      "program":     "${workspaceFolder}/backend/node_modules/.bin/jest",
      "args":        ["--runInBand", "--no-coverage"],
      "cwd":         "${workspaceFolder}/backend",
      "envFile":     "${workspaceFolder}/backend/.env",
      "env": {
        "NODE_ENV": "test"
      },
      "console":     "integratedTerminal",
      "skipFiles":   ["<node_internals>/**"]
    },

    // ── AI Service: run tests ────────────────────────────────────────────────
    {
      "name":       "🧪 Debug AI Tests",
      "type":       "debugpy",
      "request":    "launch",
      "module":     "pytest",
      "args":       ["tests/", "-v", "--tb=short", "-s"],
      "cwd":        "${workspaceFolder}/ai-service",
      "envFile":    "${workspaceFolder}/ai-service/.env",
      "justMyCode": false,
      "console":    "integratedTerminal"
    }
  ],

  // ── Compound: debug backend + AI service simultaneously ──────────────────────
  "compounds": [
    {
      "name":           "🚀 Debug Backend + AI Service",
      "configurations": ["🟢 Debug Backend (Node.js)", "🐍 Debug AI Service (FastAPI)"]
    }
  ]
}
